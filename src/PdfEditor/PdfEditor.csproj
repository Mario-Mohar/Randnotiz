<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Randnotiz</AssemblyName>
    <RootNamespace>Randnotiz</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PdfEditor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <!-- Nur die nativen PDFium-Builds (Apache-2.0), die Anbindung steht in
         Services/Pdfium.cs. Bewusst nur die beiden Plattformen, fuer die
         Randnotiz gebaut wird, nicht das Sammelpaket mit Android, iOS und
         WebAssembly. Linux und Win32 immer mit derselben Version anheben. -->
    <PackageReference Include="bblanchon.PDFium.Linux" Version="157.0.8086" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="157.0.8086" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

</Project>
