<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Randnotiz.Converters"
             x:Class="Randnotiz.App"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
    <Application.Resources>
        <conv:BoolToIsVisibleConverter x:Key="BoolToIsVisible"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:PageNumberConverter x:Key="PageNumberConverter"/>
    </Application.Resources>
</Application>
