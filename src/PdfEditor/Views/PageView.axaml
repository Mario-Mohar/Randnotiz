<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Randnotiz.Models"
             x:Class="Randnotiz.Views.PageView"
             x:DataType="models:PdfPageModel">
    <Grid Margin="0,10">
        <!-- Page container -->
        <Border BorderBrush="#CCCCCC" BorderThickness="1" Background="White"
                HorizontalAlignment="Center">
            <Grid>
                <!-- Rendered PDF page image -->
                <Image Source="{Binding RenderedImage}" Stretch="None"
                       RenderOptions.BitmapInterpolationMode="HighQuality"/>

                <!-- Canvas overlay: annotation controls are added here imperatively -->
                <Canvas x:Name="AnnotationCanvas" Background="Transparent"
                        PointerPressed="AnnotationCanvas_PointerPressed"/>
            </Grid>
        </Border>

        <!-- Page number -->
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-20"
                   Foreground="Gray" FontSize="11">
            <Run Text="Seite "/>
            <Run Text="{Binding PageIndex, Mode=OneWay, Converter={StaticResource PageNumberConverter}}"/>
        </TextBlock>
    </Grid>
</UserControl>
