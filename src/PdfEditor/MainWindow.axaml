<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Randnotiz.ViewModels"
        xmlns:views="clr-namespace:Randnotiz.Views"
        x:Class="Randnotiz.MainWindow"
        Title="Randnotiz"
        Icon="avares://Randnotiz/Assets/icon.png" Height="800" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.KeyBindings>
        <KeyBinding Gesture="Delete" Command="{Binding DeleteAnnotationCommand}"/>
    </Window.KeyBindings>
    <DockPanel>
        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                    Background="#F5F5F5" Spacing="4" Margin="4">
            <Button Content="PDF öffnen" Command="{Binding OpenCommand}" Padding="8,4"/>
            <Border Width="1" Background="#CCCCCC" Margin="4,2"/>
            <Button Content="Speichern" Command="{Binding SaveCommand}" Padding="8,4"/>
            <Button Content="Speichern unter..." Command="{Binding SaveAsCommand}" Padding="8,4"/>
            <Border Width="1" Background="#CCCCCC" Margin="4,2"/>
            <TextBlock Text="Schriftgröße:" VerticalAlignment="Center" Margin="4,0"/>
            <ComboBox ItemsSource="{Binding FontSizes}"
                      SelectedItem="{Binding SelectedFontSize}"
                      Width="70"/>
            <TextBlock Text="Schriftart:" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <ComboBox ItemsSource="{Binding FontFamilies}"
                      SelectedItem="{Binding SelectedFontFamily}"
                      Width="150"/>
        </StackPanel>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#F5F5F5" Padding="8,4">
            <TextBlock Text="{Binding CurrentFilePath, FallbackValue='Keine Datei geöffnet'}"/>
        </Border>

        <!-- PDF pages -->
        <ScrollViewer Background="#F0F0F0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Pages}" Margin="20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <views:PageView/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
